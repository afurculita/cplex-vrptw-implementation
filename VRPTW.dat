// Sample instance: the depot and the first five customers of Solomon's R101.
// Node 0 is the depot, nodes 1..CustomersNumber are customers and node
// CustomersNumber + 1 is a copy of the depot where every route ends.

v = 5;
CustomersNumber = 5;
Capacity = 200;

Demand = #[
	1: 10,
	2: 7,
	3: 13,
	4: 19,
	5: 26
]#;

ServiceTime = #[
	0: 0,
	1: 10,
	2: 10,
	3: 10,
	4: 10,
	5: 10,
	6: 0
]#;

XCoord = #[
	0: 35,
	1: 41,
	2: 35,
	3: 55,
	4: 55,
	5: 15,
	6: 35
]#;

YCoord = #[
	0: 35,
	1: 49,
	2: 17,
	3: 45,
	4: 20,
	5: 30,
	6: 35
]#;

// Lower bound of each time window (earliest start of service)
LBTW = #[
	0: 0,
	1: 161,
	2: 50,
	3: 116,
	4: 149,
	5: 34,
	6: 0
]#;

// Upper bound of each time window (latest start of service)
UBTW = #[
	0: 230,
	1: 171,
	2: 60,
	3: 126,
	4: 159,
	5: 44,
	6: 230
]#;
